        <mxCell id="4" value="assert host&#xa;Linux + systemd&#xa;Debian family" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="3">
          <mxGeometry x="35" y="55" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="5" value="assert inputs&#xa;k3s_version format&#xa;kubeconfig_user non empty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="3">
          <mxGeometry x="35" y="140" width="180" height="75" as="geometry" />
        </mxCell>
        <mxCell id="6" value="But&#xa;stopper avant modification si l'hote ou les variables sont incoherents" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="3">
          <mxGeometry x="35" y="225" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="7" value="2. Detection : lire l'etat reel" style="swimlane;startSize=34;rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="570" y="200" width="300" height="395" as="geometry" />
        </mxCell>
        <mxCell id="8" value="stat /usr/local/bin/k3s&#xa;lecture seule, compatible --check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="7">
          <mxGeometry x="40" y="55" width="220" height="65" as="geometry" />
        </mxCell>
