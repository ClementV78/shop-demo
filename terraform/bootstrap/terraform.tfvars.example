# Copier vers terraform.tfvars, qui n'est jamais commite.
# Aucune valeur reelle ici : ni identifiant de compte, ni email.

# Identifiant du compte management, douze chiffres. Sans valeur par defaut :
# Terraform refusera de demarrer tant qu'il n'est pas fourni, et refusera
# aussi de s'executer si les credentials resolus pointent ailleurs.
aws_account_id = "000000000000"

# Profil AWS CLI a utiliser. Laisser absent pour s'en remettre a AWS_PROFILE.
aws_profile = "REMPLACER"

aws_region  = "eu-west-1"
project     = "shopdemo"
environment = "bootstrap"
owner       = "shopdemo"

# Replace locally with four distinct, accessible addresses unused by AWS accounts.
account_emails = {
  security_audit   = "audit@example.com"
  workload_staging = "staging@example.com"
  workload_prod    = "prod@example.com"
  sandbox          = "sandbox@example.com"
}

# This address receives AWS Budgets and Cost Anomaly Detection notifications.
# AWS stores it in the Terraform state through the corresponding resources.
alert_email = "alerts@example.com"

monthly_budget_amount  = 25
billed_budget_amount   = 1
cost_anomaly_threshold = 5

# Keep false for the permanent low-cost baseline. Enable only for a bounded
# security review session, then review a plan that returns it to false.
enable_full_posture = false
