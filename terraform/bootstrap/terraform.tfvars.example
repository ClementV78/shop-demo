# Copier vers terraform.tfvars, qui n'est jamais commite.
# Aucune valeur reelle, aucun email, aucun identifiant de compte ici.

aws_region  = "eu-west-1"
project     = "shopdemo"
environment = "bootstrap"
owner       = "shopdemo"

